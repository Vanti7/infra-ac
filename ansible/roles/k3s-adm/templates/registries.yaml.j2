mirrors:
  "{{ k3s_registry_host }}":
    endpoint:
      - "http://{{ k3s_registry_host }}"
configs:
  "{{ k3s_registry_host }}":
    tls:
      insecure_skip_verify: true
  # ghcr.io privé : images de bootstrap (webhook cert-manager Gandi), volontairement
  # hors Harbor pour casser la dépendance circulaire Harbor↔cert-manager sur un
  # cluster neuf. PAT en lecture seule uniquement (jamais le token d'écriture CI).
  "ghcr.io":
    auth:
      username: "{{ ghcr_pull_username }}"
      password: "{{ ghcr_pull_token }}"
