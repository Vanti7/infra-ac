server {
    listen 443 ssl proxy_protocol;
    server_name {{ sso_domain }};

    # HAProxy fait du TCP passthrough : sans PROXY protocol, toutes les
    # connexions arrivent avec la source 10.42.0.1 (HAProxy) et le
    # allow/deny ci-dessous ne servirait à rien.
    set_real_ip_from 10.42.0.1;
    real_ip_header proxy_protocol;

    ssl_certificate     {{ lego_home }}/certificates/{{ sso_domain }}.crt;
    ssl_certificate_key {{ lego_home }}/certificates/{{ sso_domain }}.key;

    # admin console + realm master : uniquement WG / réseau interne
    location ~ ^/(admin|realms/master) {
        allow 10.99.0.0/24;
        allow 10.42.0.0/24;
        deny  all;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
