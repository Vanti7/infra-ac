# Généré par Ansible (rôle firewall) — ne pas éditer à la main.
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s {{ firewall_lan_network }} -o {{ firewall_wan_iface }} -j MASQUERADE
COMMIT
*raw
:PREROUTING ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
COMMIT
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p tcp -m tcp --dport 443 -j ACCEPT
-A INPUT -p udp -m udp --dport {{ firewall_wireguard_port }} -j ACCEPT
-A INPUT -s {{ firewall_mgmt_network }} -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -s {{ firewall_mgmt_network }} -p tcp -m tcp --dport 8006 -j ACCEPT
-A INPUT -s {{ firewall_lan_network }} -p tcp -m tcp --dport 53 -j ACCEPT
-A INPUT -s {{ firewall_lan_network }} -p udp -m udp --dport 53 -j ACCEPT
-A INPUT -s {{ firewall_mgmt_network }} -p icmp -j ACCEPT
-A INPUT -s {{ firewall_lan_network }} -p icmp -j ACCEPT
-A INPUT -s {{ firewall_lan_network }} -p tcp -m tcp --dport 9100 -j ACCEPT
-A INPUT -j DROP
COMMIT
