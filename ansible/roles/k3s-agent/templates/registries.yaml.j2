mirrors:
  "{{ k3s_registry_host }}":
    endpoint:
      - "http://{{ k3s_registry_host }}"
  "{{ k3s_harbor_registry_host }}":
    endpoint:
      - "http://{{ k3s_harbor_registry_host }}"
configs:
  "{{ k3s_registry_host }}":
    tls:
      insecure_skip_verify: true
  "{{ k3s_harbor_registry_host }}":
    tls:
      insecure_skip_verify: true
